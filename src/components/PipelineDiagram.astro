---
/**
 * Layer visualization rendered from src/data/capabilities.json
 * (`attest-engine capabilities --json`, refreshed by scripts/sync-release.mjs).
 * Styles in src/styles/custom.css under .pipeline-diagram.
 */
import { capabilities, costLabels, costTiers, isPlugin } from './capabilities';
const layers = capabilities.layers;
---

<div class="pipeline-diagram">
  {layers.map((layer) => (
    <div class={`pipeline-layer tier-${costTiers[layer.cost]}`}>
      <span class="layer-number">{isPlugin(layer) ? '+' : layer.id}</span>
      <div class="layer-info">
        <div class="layer-name">{layer.name}</div>
        <div class="layer-desc">{layer.description}</div>
      </div>
      <span class="layer-cost" style={`color: var(--attest-tier-${costTiers[layer.cost]})`}>{costLabels[layer.cost]}</span>
    </div>
  ))}
</div>
